{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iolinki-license-checkout",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PURCHASES_ENABLED": "false",
    "LIVE_PURCHASES_ENABLED": "false",
    "DELIVERY_ENABLED": "false",
    "MODE": "test",
    "SITE_ORIGIN": "https://iolinki.com"
  },
  "d1_databases": [{"binding":"DB","database_name":"iolinki-checkout","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "rules": [{"type":"Data","globs":["**/*.ttf"],"fallthrough":true}],
  "triggers": {"crons":["* * * * *"]}
}
